{
  "name": "real-skills-leashed",
  "version": "1.3.4+from.1.3.2",
  "private": true,
  "description": "A lightly revised and repackaged fork of Matt Pocock's Skills for Real Engineers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/nisavid/real-skills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs && npm run build-plugin-package",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "build-plugin-package": "node scripts/build-plugin-package.mjs",
    "check-plugin-package": "node scripts/build-plugin-package.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "test-codex-plugin": "node --test tests/compatibility/codex-plugin.test.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
